# Untuk Android fisik, jalankan `adb reverse tcp:8080 tcp:8080` atau ganti
# localhost dengan IP LAN host. Emulator Android dapat memakai 10.0.2.2.
# Produksi: https://stoodify.kradev.my.id/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# AI Engine Direct Fallback (Opsional, hanya untuk pengujian lokal simulator)
EXPO_PUBLIC_AI_DIRECT_URL=http://10.0.2.2:8000/chat
EXPO_PUBLIC_AI_KEY=your_ai_api_key_here

# Ambient Audio CDN Streaming URL
EXPO_PUBLIC_AMBIENT_AUDIO_URL=https://res.cloudinary.com/hpukknei/video/upload/v1795132569/study-ambient.mp3

# Google Sign-In Web Client ID (didapat dari Google Cloud Console OAuth 2.0 Credentials - Web Client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
