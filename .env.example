# Base URL API Backend Stoodify (Golang Gin)
# Default Local:
# - Android Emulator: http://10.0.2.2:8080/api
# - Perangkat Fisik (via adb reverse tcp:8080 tcp:8080) / Web: http://localhost:8080/api
# - Production: https://stoodify.kradev.my.id/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# URL Web App Stoodify yang dimuat oleh WebView container
EXPO_PUBLIC_APP_URL=https://stoodify-mobile-app.vercel.app
